# Snipe-IT API
SNIPEIT_URL=https://snipe-it.example.com
SNIPEIT_API_TOKEN=replace_with_server_secret
SNIPEIT_VERIFY_SSL=true

# Asset ownership prefixes used by monthly fee reports
SNIPEIT_RENTAL_PREFIX=RENT-
SNIPEIT_OWNED_PREFIX=OWN-

# Excel sync
SNIPEIT_EXCEL_PATH=D:\\SnipeIT-Automation\\output\\assets.xlsx
SNIPEIT_SHEET_NAME=Assets
SNIPEIT_STATE_PATH=D:\\SnipeIT-Automation\\state\\sync-state.json
SNIPEIT_STATUS_DIR=D:\\SnipeIT-Automation\\status

# API paging and activity filters
SNIPEIT_ITEM_TYPE=asset
SNIPEIT_ACTION_TYPES=checkout,checkin,update,create
SNIPEIT_PAGE_SIZE=500
SNIPEIT_MAX_PAGES=100
SNIPEIT_COUNT_CACHE_SECONDS=300

# Optional shared environment file used by wrapper scripts
SNIPEIT_ENV_PATH=D:\\SnipeIT-Automation\\config\\.env.snipeit-excel
